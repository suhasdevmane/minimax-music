# Copy to .env and adjust. .env is gitignored; never commit it.
#   cp .env.example .env
#
# The defaults below suit a bare host. docker-compose.yml sets its own
# container paths (/models/...) explicitly, so you do not need to change
# anything here for Docker.

# Where the 54 GB of model weights live.
# Leave blank to use ./minimax_ttm inside the project, which is what
# scripts/fetch_model.py defaults to. Set an absolute path to keep the
# weights on a different disk.
MINIMAX_MODEL_DIR=

# Hugging Face cache. Leave blank for the default (~/.cache/huggingface).
# The download streams through here, so point it at a disk with room if
# your home directory is small.
HF_HOME=

# Only needed if the weights repo ever becomes gated. Leave blank otherwise.
HF_TOKEN=

# Which GPU to use. A render needs one card and about 7 GB of VRAM.
# On a shared machine, pin a specific card: 0 or 1.
CUDA_VISIBLE_DEVICES=0

# Seconds of audio to request per render. The model's hard cap is 360.
RENDER_DURATION=355

# Sampling seed. The catalogue's voice recipe depends on this staying 42.
RENDER_SEED=42
