# Copy to .env and adjust. .env is gitignored; never commit it.
#   cp .env.example .env

# Where the 54 GB of model weights live. Inside the container this is the
# mounted volume; on a bare host it defaults to ./minimax_ttm.
MINIMAX_MODEL_DIR=/models/minimax_ttm

# Hugging Face cache location. Keep it on a disk with room to spare: the
# download streams through here before landing in MINIMAX_MODEL_DIR.
HF_HOME=/models/hf

# Only needed if the weights repo ever becomes gated. Leave blank otherwise.
HF_TOKEN=

# Which GPU to use. The render needs one card and about 7 GB of VRAM.
# On a shared machine, pin a specific card: 0 or 1.
CUDA_VISIBLE_DEVICES=0

# Seconds of audio to request per render. The model's hard cap is 360.
RENDER_DURATION=355

# Sampling seed. The catalogue's voice recipe depends on this staying 42.
RENDER_SEED=42
